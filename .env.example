# ===== Servidor =====
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# ===== Banco de dados =====
DATABASE_URL=postgresql://kim:kim@localhost:5432/kim?schema=public

# ===== IA (Claude / Anthropic) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Modelo padrão usado pelo orquestrador e agentes
AI_MODEL=claude-opus-4-8

# ===== WhatsApp Cloud API (Meta) =====
# Token de verificação que você define no painel da Meta para o webhook
WHATSAPP_VERIFY_TOKEN=kim-verify-token
# ID do número de telefone (Phone Number ID) da WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
# Token de acesso permanente do System User
WHATSAPP_ACCESS_TOKEN=
# App Secret (usado para validar a assinatura X-Hub-Signature-256 do webhook)
WHATSAPP_APP_SECRET=
# Versão da Graph API
WHATSAPP_GRAPH_VERSION=v21.0

# ===== Auth =====
JWT_SECRET=troque-este-segredo-em-producao
