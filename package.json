{
  "name": "kim-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM de WhatsApp com agentes de IA para redes de franquias",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:generate": "npm run db:generate --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
