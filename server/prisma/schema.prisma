// KIM — CRM de WhatsApp para redes de franquias
// Modelo de dados (Prisma + PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy ─────────────────────────────

/// Organização = a rede de franquias (cliente do KIM)
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  franchises Franchise[]
  users      User[]
  channels   WhatsAppChannel[]
  queues     Queue[]
  aiAgents   AIAgent[]
  contacts   Contact[]
  tags       Tag[]
  conversations Conversation[]
}

/// Franquia = uma unidade da rede
model Franchise {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  city           String?
  state          String?
  externalCode   String? // código interno da rede
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queues       Queue[]
  conversations Conversation[]

  @@index([organizationId])
}

// ───────────────────────────── Usuários ─────────────────────────────

enum UserRole {
  OWNER // dono da rede
  ADMIN // administrador
  MANAGER // gerente de unidade
  AGENT // atendente humano
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(AGENT)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("AssignedUser")

  @@index([organizationId])
}

// ───────────────────────── Canais WhatsApp ──────────────────────────

/// Número WhatsApp conectado via Meta Cloud API
model WhatsAppChannel {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phoneNumberId  String   @unique // Phone Number ID da Meta
  displayPhone   String? // número exibido (ex: +55 11 ...)
  accessToken    String? // se quiser por canal (senão usa env)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([organizationId])
}

// ───────────────────────────── Filas ────────────────────────────────

/// Fila de atendimento (multi-fila). O orquestrador direciona para a fila certa.
model Queue {
  id             String   @id @default(cuid())
  organizationId String
  franchiseId    String?
  name           String
  description    String? // usado pelo orquestrador para entender o propósito da fila
  /// palavras-chave que ajudam o roteamento (fallback caso a IA não esteja disponível)
  keywords       String[] @default([])
  color          String   @default("#6366f1")
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  franchise     Franchise?     @relation(fields: [franchiseId], references: [id])
  aiAgents      AIAgent[]
  conversations Conversation[]

  @@index([organizationId])
}

// ───────────────────────── Agentes de IA ────────────────────────────

/// Agente especialista de IA, associado a uma fila.
model AIAgent {
  id             String   @id @default(cuid())
  organizationId String
  queueId        String?
  name           String
  /// persona / instruções de sistema do agente especialista
  systemPrompt   String
  /// base de conhecimento (FAQ, políticas) injetada no contexto
  knowledge      String?
  model          String   @default("claude-opus-4-8")
  /// temperatura simbólica via "effort": low|medium|high
  effort         String   @default("medium")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queue         Queue?         @relation(fields: [queueId], references: [id])
  conversations Conversation[]

  @@index([organizationId])
}

// ───────────────────────────── Contatos ─────────────────────────────

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  /// número no formato E.164 sem '+' (ex: 5511999999999)
  waId           String
  name           String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([organizationId, waId])
  @@index([organizationId])
}

// ─────────────────────────── Conversas ──────────────────────────────

enum ConversationStatus {
  OPEN // em atendimento
  WAITING // aguardando cliente
  RESOLVED // resolvida
  CLOSED // encerrada
}

/// Quem está conduzindo a conversa neste momento
enum HandlingMode {
  AI // agente de IA respondendo
  HUMAN // atendente humano assumiu
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  contactId      String
  channelId      String
  franchiseId    String?
  queueId        String?
  aiAgentId      String?
  assignedUserId String?
  status         ConversationStatus @default(OPEN)
  handlingMode   HandlingMode       @default(AI)
  /// resumo gerado por IA da conversa (para handoff e contexto)
  summary        String?
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id])
  channel        WhatsAppChannel  @relation(fields: [channelId], references: [id])
  franchise      Franchise?       @relation(fields: [franchiseId], references: [id])
  queue          Queue?           @relation(fields: [queueId], references: [id])
  aiAgent        AIAgent?         @relation(fields: [aiAgentId], references: [id])
  assignedUser   User?            @relation("AssignedUser", fields: [assignedUserId], references: [id])
  messages       Message[]
  tags           ConversationTag[]
  classification Classification?
  npsSurvey      NpsSurvey?

  @@index([organizationId, status])
  @@index([queueId])
}

enum SenderType {
  CONTACT // cliente final
  AI // agente de IA
  HUMAN // atendente humano
  SYSTEM // eventos do sistema
}

model Message {
  id             String     @id @default(cuid())
  conversationId String
  senderType     SenderType
  /// id do usuário humano ou agente IA que enviou (opcional)
  senderId       String?
  text           String
  /// id da mensagem na Meta (wamid) para idempotência
  waMessageId    String?    @unique
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ────────────────────────────── Tags ────────────────────────────────

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#10b981")
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([organizationId, name])
}

model ConversationTag {
  conversationId String
  tagId          String
  /// true se a tag foi aplicada automaticamente pela IA
  auto           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

// ─────────────────────── Classificação por IA ───────────────────────

model Classification {
  id             String   @id @default(cuid())
  conversationId String   @unique
  intent         String? // ex: "abrir_franquia", "suporte", "reclamacao"
  category       String? // ex: "Vendas", "Financeiro"
  /// POSITIVE | NEUTRAL | NEGATIVE
  sentiment      String?
  priority       String? // LOW | MEDIUM | HIGH
  confidence     Float?
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── NPS ──────────────────────────────────

enum NpsStatus {
  PENDING // pesquisa enviada, aguardando
  RESPONDED // respondida
  EXPIRED // sem resposta
}

model NpsSurvey {
  id             String    @id @default(cuid())
  conversationId String    @unique
  status         NpsStatus @default(PENDING)
  /// 0–10
  score          Int?
  comment        String?
  /// PROMOTER | PASSIVE | DETRACTOR (derivado do score)
  category       String?
  sentAt         DateTime  @default(now())
  respondedAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
